# ══════════════════════════════════════════════════════════════════
# OneStop by Two19 Labs  -  Environment Variables
# ══════════════════════════════════════════════════════════════════

# Supabase Connection
# 1. Create a free project at https://supabase.com
# 2. Copy Project URL and Anon Key from Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Note on Email & Google Auth:
# - Brevo SMTP credentials (for 300 free emails/day) are configured directly in Supabase Dashboard > Authentication > SMTP Settings.
# - Google OAuth credentials are configured in Google Cloud Console & Supabase Dashboard > Authentication > Providers > Google.
# See SUPABASE_SETUP.md for complete step-by-step instructions.

# Google Identity Services (optional): use Google's own sign-in button so the
# Google popup shows our domain instead of the Supabase project URL.
# Use the same Web client ID configured in Supabase > Auth > Providers > Google,
# and add the site URL under that client's Authorized JavaScript origins.
# Leave empty to use the Supabase OAuth redirect flow.
VITE_GOOGLE_CLIENT_ID=

# PostHog Product Analytics & Session Recording
# 1. Create a free project at https://posthog.com
# 2. Copy Project API Key from Project Settings > Project Variables
# 3. Default host is https://us.i.posthog.com (or https://eu.i.posthog.com for EU cloud)
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Google AI Studio Gemini API (100% Free Tier: 1,500 requests/day, $0 cost)
# 1. Go to https://aistudio.google.com/app/apikey
# 2. Click "Create API key"
# 3. Paste the key below:
GEMINI_API_KEY=your_gemini_api_key

# Supabase Service Role Key (for automated backend scanner scripts / GitHub Actions)
# Found in Supabase Dashboard > Project Settings > API > service_role (secret)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
